<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns
                             http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d0" for="edge" attr.name="color" attr.type="int"/>
  <graph id="G" edgedefault="undirected">
    <node id="n0"/>
    <node id="n1"/>
    <node id="n2"/>
    <node id="n3"/>
    <node id="n4"/>
    <edge id="e0" source="n0" target="n1">
      <data key="d0">3</data>
    </edge>
    <edge id="e1" source="n0" target="n2">
      <data key="d0">0</data>
    </edge>
    <edge id="e2" source="n0" target="n3">
      <data key="d0">6</data>
    </edge>
    <edge id="e3" source="n0" target="n4">
      <data key="d0">1</data>
    </edge>
    <edge id="e4" source="n1" target="n2">
      <data key="d0">2</data>
    </edge>
    <edge id="e5" source="n1" target="n3">
      <data key="d0">5</data>
    </edge>
    <edge id="e6" source="n1" target="n4">
      <data key="d0">4</data>
    </edge>
    <edge id="e7" source="n2" target="n3">
      <data key="d0">1</data>
    </edge>
    <edge id="e8" source="n2" target="n4">
      <data key="d0">6</data>
    </edge>
    <edge id="e9" source="n3" target="n4">
      <data key="d0">0</data>
    </edge>
  </graph>
</graphml>
